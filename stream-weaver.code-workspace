{
  "folders": [
    {
      "name": "🧶 Stream Weaver (Control Plane)",
      "path": "."
    },
    {
      "name": "🕶️ Contraband (Addon Repo)",
      "path": "../aio_contraband"
    }
  ],
  "settings": {
    "window.title": "${activeEditorShort}${separator}${rootName}${separator}Stream Weaver & Contraband",
    "python.defaultInterpreterPath": "${workspaceFolder:🧶 Stream Weaver (Control Plane)}/.venv/bin/python",
    "python.analysis.extraPaths": [
      "${workspaceFolder:🧶 Stream Weaver (Control Plane)}/src",
      "${workspaceFolder:🕶️ Contraband (Addon Repo)}/src"
    ],
    "files.exclude": {
      "**/__pycache__": true,
      "**/.DS_Store": true,
      "**/.mypy_cache": true,
      "**/.pytest_cache": true,
      "**/.ruff_cache": true,
      "**/.hypothesis": true
    },
    "search.exclude": {
      "**/stream/series/**": true,
      "**/stream/movie/**": true,
      "**/meta/library/**": true,
      "**/.venv/**": true
    },
    "editor.formatOnSave": true,
    "[json]": {
      "editor.tabSize": 2
    },
    "[jsonc]": {
      "editor.tabSize": 2
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "charliermarsh.ruff",
      "tamasfe.even-better-toml",
      "mikestead.dotenv",
      "ms-azuretools.vscode-containers"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "⬆️ Push Configs (AIOStreams, AIOMetadata, AIOManager, Nuvio & Stremio)",
        "type": "shell",
        "command": "uv run sw push",
        "options": {
          "cwd": "${workspaceFolder:🧶 Stream Weaver (Control Plane)}"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        }
      },
      {
        "label": "⬇️ Pull & Sanitize Configs",
        "type": "shell",
        "command": "uv run sw pull",
        "options": {
          "cwd": "${workspaceFolder:🧶 Stream Weaver (Control Plane)}"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        }
      },
      {
        "label": "🔄 Sync TorBox Library -> Contraband",
        "type": "shell",
        "command": "uv run cb sync",
        "options": {
          "cwd": "${workspaceFolder:🕶️ Contraband (Addon Repo)}"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        }
      },
      {
        "label": "👀 Watch & Drain TorBox Queue (3x Parallel)",
        "type": "shell",
        "command": "uv run cb watch",
        "options": {
          "cwd": "${workspaceFolder:🕶️ Contraband (Addon Repo)}"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        }
      },
      {
        "label": "📋 List TorBox Cloud Library & Queue",
        "type": "shell",
        "command": "uv run cb list",
        "options": {
          "cwd": "${workspaceFolder:🕶️ Contraband (Addon Repo)}"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        }
      },
      {
        "label": "✅ Run Tests, Ruff & Strict Mypy (Stream Weaver)",
        "type": "shell",
        "command": "uv run ruff check src tests && uv run mypy src tests && uv run pytest",
        "options": {
          "cwd": "${workspaceFolder:🧶 Stream Weaver (Control Plane)}"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        }
      }
    ]
  }
}
