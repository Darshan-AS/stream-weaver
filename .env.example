# ==============================================================================
# 1. INSTANCE URLS (Point to Public Hosted now -> Swap to Self-Hosted later)
# ==============================================================================
# No trailing slashes. Examples:
# Public AIOStreams:  https://aiostreams.elfhosted.com (or your chosen public instance)
# Public AIOMetadata: https://aiometadata.elfhosted.com (or your chosen public instance)
# Public AIOManager:  https://aiomanager.elfhosted.com (or your chosen public instance)
AIOSTREAMS_URL=https://aiostreams.elfhosted.com
AIOMETADATA_URL=https://aiometadata.elfhosted.com
AIOMANAGER_URL=https://aiomanager.elfhosted.com

# ==============================================================================
# 2. INSTANCE CREDENTIALS (UUID + Password for each service)
# ==============================================================================
# Tip: Your UUID is visible in your addon install URL or when you save/load config.

# --- AIOStreams ---
AIOSTREAMS_UUID=
AIOSTREAMS_PASSWORD=
# Optional: only needed if the instance requires a global addon access password
AIOSTREAMS_ADDON_PASSWORD=

# --- AIOMetadata ---
AIOMETADATA_UUID=
AIOMETADATA_PASSWORD=
# Optional: only needed if the instance requires a global addon password
AIOMETADATA_ADDON_PASSWORD=

# --- AIOManager (Cloud Sync) ---
# Only needed if you enable Cloud Sync in AIOManager (Settings -> Sync)
AIOMANAGER_UUID=
AIOMANAGER_SYNC_PASSWORD=

# ==============================================================================
# 3. SECRETS FOR GIT SCRUBBING (Prefix with SECRET_)
# ==============================================================================
# Any non-empty variable starting with SECRET_ will be:
#   - Scrubbed into {{SECRET_...}} when running `uv run sw pull` or `uv run sw sanitize`
#   - Injected back in memory when running `uv run sw push`
# This keeps your configs/*.json files 100% safe to commit to Git!

# Debrid / Usenet API Keys (used in AIOStreams)
SECRET_RD_API_KEY=
SECRET_TORBOX_API_KEY=
SECRET_ALLDEBRID_API_KEY=
SECRET_PREMIUMIZE_API_KEY=
SECRET_EASYNEWS_USERNAME=
SECRET_EASYNEWS_PASSWORD=

# Metadata, Artwork & Recommendation API Keys (used in AIOMetadata / AIOStreams / AIOManager)
SECRET_TMDB_API_KEY=
SECRET_TMDB_ACCESS_TOKEN=
SECRET_TVDB_API_KEY=
SECRET_RPDB_API_KEY=
SECRET_TOP_POSTER_API_KEY=
SECRET_FANART_API_KEY=
SECRET_MDBLIST_API_KEY=
SECRET_TRAKT_TOKEN_ID=
# Optional: your own Trakt API app, only for scripts/trakt_backfill.py (one-off history import)
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
SECRET_GEMINI_API_KEY=
SECRET_OPENROUTER_API_KEY=
SECRET_BINGECAT_TOKEN=
SECRET_WATCHLY_TOKEN=
# Auto-harvested addon URL tokens & account PII from AIOManager (populated by `sw pull` / `sw sanitize`)
SECRET_AIOSTREAMS_ENCRYPTED_PASSWORD=
SECRET_AIOMETADATA_TOKEN=

# Optional Nuvio Supabase public anon key (used for direct Nuvio profile addon sync)
NUVIO_SUPABASE_ANON_KEY=
