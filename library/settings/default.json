{
  "$schema": "https://stream-weaver.dev/schemas/recipe.settings.v1.json",
  "version": 1,
  "kind": "settings",
  "id": "default",
  "ui": {
    "title": "Ocean AMOLED + Reuse Last Link",
    "description": "Modern TV Home layout, 24h Reuse Last Link, auto-skip intro/recap, and HDR subtitle styling."
  },
  "params": {
    "theme": {
      "type": "string",
      "label": "Accent Theme",
      "default": "ocean",
      "options": [
        { "label": "Ocean", "value": "ocean" },
        { "label": "Crimson", "value": "crimson" },
        { "label": "Violet", "value": "violet" },
        { "label": "Emerald", "value": "emerald" },
        { "label": "Amber", "value": "amber" },
        { "label": "Rose", "value": "rose" },
        { "label": "Gold (TV/Desktop)", "value": "gold" },
        { "label": "Jade (TV/Desktop)", "value": "jade" },
        { "label": "Rose Gold (TV/Desktop)", "value": "rose_gold" },
        { "label": "Arctic Blue (TV/Desktop)", "value": "arctic_blue" },
        { "label": "Graphite (TV/Desktop)", "value": "graphite" },
        { "label": "White", "value": "white" }
      ]
    },
    "amoledBlack": {
      "type": "bool",
      "label": "AMOLED Pure Black",
      "default": true
    },
    "homeLayout": {
      "type": "string",
      "label": "TV Home Layout",
      "default": "modern",
      "options": [
        { "label": "Modern (Hero + Rows)", "value": "modern" },
        { "label": "Grid", "value": "grid" },
        { "label": "Classic", "value": "classic" }
      ]
    },
    "streamSelectionMode": {
      "type": "string",
      "label": "Stream Selection Mode",
      "default": "manual",
      "options": [
        { "label": "Manual Stream Picker", "value": "manual" },
        { "label": "Auto-Play First Stream", "value": "firstStream" }
      ]
    },
    "audioPreferred": {
      "type": "string",
      "label": "Preferred Audio Language",
      "default": "original",
      "options": [
        { "label": "Original Track", "value": "original" },
        { "label": "English", "value": "en" },
        { "label": "Device Language", "value": "device" },
        { "label": "Japanese", "value": "ja" },
        { "label": "Korean", "value": "ko" },
        { "label": "Hindi", "value": "hi" },
        { "label": "Kannada", "value": "kn" },
        { "label": "Tamil", "value": "ta" },
        { "label": "Telugu", "value": "te" },
        { "label": "Malayalam", "value": "ml" },
        { "label": "Spanish", "value": "es" },
        { "label": "French", "value": "fr" },
        { "label": "German", "value": "de" },
        { "label": "Portuguese", "value": "pt" }
      ]
    },
    "subtitlePreferred": {
      "type": "string",
      "label": "Preferred Subtitle Language",
      "default": "en",
      "options": [
        { "label": "English", "value": "en" },
        { "label": "Spanish", "value": "es" },
        { "label": "French", "value": "fr" },
        { "label": "German", "value": "de" },
        { "label": "Portuguese", "value": "pt" },
        { "label": "Italian", "value": "it" },
        { "label": "Japanese", "value": "ja" },
        { "label": "Korean", "value": "ko" },
        { "label": "Chinese", "value": "zh" },
        { "label": "Arabic", "value": "ar" },
        { "label": "Turkish", "value": "tr" },
        { "label": "Hindi", "value": "hi" },
        { "label": "Kannada", "value": "kn" },
        { "label": "Tamil", "value": "ta" },
        { "label": "Telugu", "value": "te" },
        { "label": "Malayalam", "value": "ml" },
        { "label": "Bengali", "value": "bn" },
        { "label": "Marathi", "value": "mr" }
      ]
    },
    "subtitleSecondary": {
      "type": "string",
      "label": "Secondary Subtitle Language",
      "nullable": true,
      "default": null,
      "options": [
        { "label": "None", "value": null },
        { "label": "English", "value": "en" },
        { "label": "Spanish", "value": "es" },
        { "label": "French", "value": "fr" },
        { "label": "German", "value": "de" },
        { "label": "Portuguese", "value": "pt" },
        { "label": "Italian", "value": "it" },
        { "label": "Japanese", "value": "ja" },
        { "label": "Korean", "value": "ko" },
        { "label": "Chinese", "value": "zh" },
        { "label": "Arabic", "value": "ar" },
        { "label": "Turkish", "value": "tr" },
        { "label": "Hindi", "value": "hi" },
        { "label": "Kannada", "value": "kn" },
        { "label": "Tamil", "value": "ta" },
        { "label": "Telugu", "value": "te" },
        { "label": "Malayalam", "value": "ml" },
        { "label": "Bengali", "value": "bn" },
        { "label": "Marathi", "value": "mr" }
      ]
    },
    "subtitleSizeSp": {
      "type": "int",
      "label": "Desktop/Mobile Subtitle Size (sp)",
      "default": 18
    },
    "tvSubtitleSizePercent": {
      "type": "int",
      "label": "TV Subtitle Scale (%)",
      "default": 100
    },
    "blurUnwatchedEpisodes": {
      "type": "bool",
      "label": "Blur Unwatched Episode Spoilers (TV)",
      "default": false
    }
  },
  "settings": {
    "version": "1.0.0",
    "platforms": [
      "tv",
      "desktop",
      "mobile"
    ],
    "appearance": {
      "theme": "${theme}",
      "amoledBlack": "${amoledBlack}",
      "navBarStyle": "adaptive",
      "desktopNavigation": "topBar",
      "tv": {
        "font": "inter",
        "amoledSurfaces": false,
        "settingsUiStyle": "classic",
        "startupSplash": true
      }
    },
    "playback": {
      "reuseLastLink": {
        "enabled": true,
        "cacheHours": 24
      },
      "streamSelection": {
        "mode": "${streamSelectionMode}",
        "scope": "all",
        "allowedAddons": [],
        "regex": "",
        "timeoutSeconds": 3
      },
      "nextEpisode": {
        "autoPlay": true,
        "preferBingeGroup": true,
        "reuseBingeGroup": true,
        "fallbackToFirstStream": true,
        "thresholdMode": "percentage",
        "thresholdPercent": 99.0,
        "thresholdMinutesBeforeEnd": 2.0,
        "preloadNextEpisodeSources": true,
        "stillWatchingPrompt": {
          "enabled": false,
          "episodeThreshold": 3
        }
      },
      "skip": {
        "skipIntro": true,
        "autoSkip": [
          "intro",
          "recap"
        ],
        "animeSkip": {
          "enabled": false,
          "clientId": ""
        },
        "introDbApiKey": ""
      },
      "ui": {
        "loadingOverlay": true,
        "contentWarnings": false,
        "holdToSpeed": {
          "enabled": true,
          "speed": 2.0
        },
        "touchGestures": true,
        "tv": {
          "pauseOverlay": true,
          "osdClock": true,
          "showLoadingStatus": true,
          "postPlayRecommendations": true,
          "postPlayMovieThresholdPercent": 96,
          "playbackIssueReports": false
        }
      },
      "externalPlayer": {
        "enabled": false,
        "forwardSubtitles": true,
        "sendSkipSegments": true
      }
    },
    "audio": {
      "preferredLanguage": "${audioPreferred}",
      "secondaryLanguage": "en",
      "tv": {
        "skipSilence": false
      }
    },
    "subtitles": {
      "preferredLanguage": "${subtitlePreferred}",
      "secondaryLanguage": "${subtitleSecondary}",
      "useForced": true,
      "showOnlyPreferredLanguages": false,
      "stripSdh": true,
      "addonStartupMode": "preferredOnly",
      "style": {
        "textColor": "#FFFFFFFF",
        "backgroundColor": "#00000000",
        "outline": {
          "enabled": true,
          "color": "#FF000000",
          "width": 2
        },
        "bold": false,
        "sizeSp": "${subtitleSizeSp}",
        "bottomOffset": 20
      },
      "tv": {
        "sizePercent": "${tvSubtitleSizePercent}",
        "verticalOffsetPercent": 5,
        "organizationMode": "byLanguage",
        "hdrStyle": {
          "enabled": true,
          "textColor": "#FFFFFFFF",
          "brightness": 40,
          "dimPlayerControls": false
        }
      }
    },
    "tvLayout": {
      "homeLayout": "${homeLayout}",
      "heroSection": true,
      "heroCatalogKeys": [],
      "heroFullScreenBackdrop": false,
      "sidebar": {
        "collapsedByDefault": false,
        "modern": true,
        "blur": false
      },
      "discoverLocation": "inSidebar",
      "posters": {
        "labels": true,
        "addonName": false,
        "catalogType": false,
        "landscapeMode": false,
        "alwaysLandscapeClearlogo": false,
        "classicFocusGradient": false,
        "widthDp": 126,
        "heightDp": 189,
        "cornerRadiusDp": 16
      },
      "focusedPoster": {
        "expandToBackdrop": true,
        "expandDelaySeconds": 3,
        "autoplayTrailer": true,
        "trailerMuted": true,
        "trailerTarget": "heroMedia"
      },
      "cardDepth": {
        "enabled": true,
        "edgeStrength": 28,
        "sheenStrength": 10,
        "edgeCoverage": 0,
        "posters": true,
        "continueWatching": true,
        "episodeCards": true,
        "cast": true,
        "trailers": true
      },
      "continueWatching": {
        "enabled": true,
        "cardStyle": "card",
        "sortMode": "streaming",
        "episodeThumbnails": true,
        "showUnairedNextUp": true,
        "nextUpFromFurthestEpisode": true,
        "blurNextUp": false
      },
      "details": {
        "trailerButton": true,
        "preferExternalMetaAddon": true,
        "blurUnwatchedEpisodes": "${blurUnwatchedEpisodes}",
        "showFullReleaseDate": true,
        "episodeOptionsOverlay": "blur",
        "randomEpisodeShuffle": true
      },
      "homeImdbRatings": "showAll",
      "hideUnreleasedContent": false,
      "followAddonsOrder": false,
      "performance": {
        "memoryOnlyVerticalScroll": true,
        "smoothBringIntoView": true,
        "fastHorizontalNavigation": false
      }
    },
    "notifications": {
      "episodeReleaseAlerts": true
    },
    "tvPlugins": {
      "groupStreamsByRepository": true
    }
  }
}
