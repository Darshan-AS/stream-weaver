{
  "$schema": "https://stream-weaver.dev/schemas/recipe.collection.v1.json",
  "version": 1,
  "kind": "collection",
  "id": "col-discover",
  "ui": {
    "title": "Discover",
    "description": "Lightweight Trending & Popular and Top Rated All-Time tabs without BingeCat or release alerts.",
    "category": "discovery"
  },
  "params": {
    "backdropImageUrl": {
      "type": "string",
      "default": ""
    },
    "pinToTop": {
      "type": "bool",
      "default": true
    }
  },
  "collection": {
    "id": "col-discover",
    "title": "Discover",
    "folders": [
      {
        "ref": "fld-trending-popular"
      },
      {
        "ref": "fld-top-rated"
      }
    ],
    "pinToTop": "${pinToTop}",
    "viewMode": "TABBED_GRID",
    "showAllTab": true,
    "backdropImageUrl": "${backdropImageUrl}",
    "focusGlowEnabled": true
  }
}
