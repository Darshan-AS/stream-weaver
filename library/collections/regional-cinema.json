{
  "$schema": "https://stream-weaver.dev/schemas/recipe.collection.v1.json",
  "version": 1,
  "kind": "collection",
  "id": "regional-cinema",
  "ui": {
    "title": "Regional & World Cinema",
    "description": "Parameterised Movies (New, Popular, Top Rated, 80s/90s/2000s Classics) and Series folders for any ISO language.",
    "category": "regional",
    "presets": [
      { "label": "Kannada Cinema", "with": { "language": "kn", "slug": "kannada", "label": "Kannada" } },
      { "label": "Hindi Cinema", "with": { "language": "hi", "slug": "hindi", "label": "Hindi" } },
      { "label": "Tamil Cinema", "with": { "language": "ta", "slug": "tamil", "label": "Tamil" } },
      { "label": "Telugu Cinema", "with": { "language": "te", "slug": "telugu", "label": "Telugu" } },
      { "label": "Malayalam Cinema", "with": { "language": "ml", "slug": "malayalam", "label": "Malayalam" } },
      { "label": "Bengali Cinema", "with": { "language": "bn", "slug": "bengali", "label": "Bengali" } },
      { "label": "Marathi Cinema", "with": { "language": "mr", "slug": "marathi", "label": "Marathi" } },
      { "label": "Korean Cinema & Drama", "with": { "language": "ko", "slug": "korean", "label": "Korean" } },
      { "label": "Japanese Cinema & Drama", "with": { "language": "ja", "slug": "japanese", "label": "Japanese" } },
      { "label": "French Cinema", "with": { "language": "fr", "slug": "french", "label": "French" } },
      { "label": "Spanish Cinema", "with": { "language": "es", "slug": "spanish", "label": "Spanish" } }
    ]
  },
  "params": {
    "language": {
      "type": "string",
      "label": "ISO-639-1 Language Code"
    },
    "slug": {
      "type": "string",
      "label": "Catalog ID Slug"
    },
    "label": {
      "type": "string",
      "label": "Display Label"
    },
    "decades": {
      "type": "list",
      "items": "object",
      "default": [
        {
          "id": "80s",
          "label": "80s",
          "from": "1900-01-01",
          "to": "1989-12-31"
        },
        {
          "id": "90s",
          "label": "90s",
          "from": "1990-01-01",
          "to": "1999-12-31"
        },
        {
          "id": "2000s",
          "label": "2000s",
          "from": "2000-01-01",
          "to": "2009-12-31"
        }
      ]
    },
    "series": {
      "type": "bool",
      "default": true
    },
    "moviesCoverImageUrl": {
      "type": "string",
      "default": ""
    },
    "seriesCoverImageUrl": {
      "type": "string",
      "default": ""
    },
    "backdropImageUrl": {
      "type": "string",
      "default": ""
    },
    "pinToTop": {
      "type": "bool",
      "default": true
    }
  },
  "collection": {
    "id": "col-${slug}",
    "title": "${label}",
    "folders": [
      {
        "ref": "regional-movies",
        "with": {
          "language": "${language}",
          "slug": "${slug}",
          "label": "${label}",
          "decades": "${decades}",
          "coverImageUrl": "${moviesCoverImageUrl}"
        }
      },
      {
        "if": "${series}",
        "item": {
          "ref": "regional-series",
          "with": {
            "language": "${language}",
            "slug": "${slug}",
            "label": "${label}",
            "coverImageUrl": "${seriesCoverImageUrl}"
          }
        }
      }
    ],
    "pinToTop": "${pinToTop}",
    "viewMode": "TABBED_GRID",
    "showAllTab": true,
    "backdropImageUrl": "${backdropImageUrl}",
    "focusGlowEnabled": true
  }
}
