{
  "$schema": "https://stream-weaver.dev/schemas/recipe.collection.v1.json",
  "version": 1,
  "kind": "collection",
  "id": "col-streaming-services",
  "params": {
    "services": {
      "type": "list",
      "items": "string",
      "default": [
        "fld-netflix",
        "fld-prime-video",
        "fld-apple-tv",
        "fld-hbo-max",
        "fld-disney-plus",
        "fld-hulu",
        "fld-paramount-plus",
        "fld-peacock"
      ]
    },
    "pinToTop": {
      "type": "bool",
      "default": true
    }
  },
  "collection": {
    "id": "col-streaming-services",
    "title": "Streaming Services",
    "folders": [
      {
        "for": "s",
        "in": "${services}",
        "item": {
          "ref": "${s}"
        }
      }
    ],
    "pinToTop": "${pinToTop}",
    "viewMode": "TABBED_GRID",
    "showAllTab": true,
    "backdropImageUrl": "https://imkaptain.github.io/nuvio-assets/assets/images/6671230f.webp",
    "focusGlowEnabled": true
  }
}
