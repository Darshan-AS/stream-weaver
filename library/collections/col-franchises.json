{
  "$schema": "https://stream-weaver.dev/schemas/recipe.collection.v1.json",
  "version": 1,
  "kind": "collection",
  "id": "col-franchises",
  "ui": {
    "title": "Franchises, Studios & Classics",
    "description": "MCU, Star Wars & Lucasfilm, DC, Studio Ghibli, plus optional A24, Pixar & DreamWorks, and 70s–90s Cinema Classics tabs.",
    "category": "studios"
  },
  "params": {
    "franchises": {
      "type": "list",
      "items": "string",
      "label": "Included Studio & Universe Folders",
      "options": [
        { "label": "Marvel Cinematic Universe", "value": "fld-franchise-mcu" },
        { "label": "Star Wars & Lucasfilm", "value": "fld-franchise-star-wars" },
        { "label": "DC", "value": "fld-franchise-dc" },
        { "label": "Studio Ghibli", "value": "fld-franchise-ghibli" },
        { "label": "A24", "value": "fld-studio-a24" },
        { "label": "Pixar & DreamWorks", "value": "fld-studio-pixar" },
        { "label": "70s–90s Cinema Classics", "value": "fld-cinema-classics" }
      ],
      "default": [
        "fld-franchise-mcu",
        "fld-franchise-star-wars",
        "fld-franchise-dc",
        "fld-franchise-ghibli"
      ]
    }
  },
  "collection": {
    "id": "col-franchises",
    "title": "Franchises & Universes",
    "folders": [
      {
        "for": "f",
        "in": "${franchises}",
        "item": {
          "ref": "${f}"
        }
      }
    ],
    "pinToTop": true,
    "viewMode": "TABBED_GRID",
    "showAllTab": true,
    "backdropImageUrl": "https://image.tmdb.org/t/p/w1280/9BBTo63ANSmhC4e6r62OJFuK2GL.jpg",
    "focusGlowEnabled": true
  }
}
