{
  "$schema": "https://stream-weaver.dev/schemas/recipe.catalog.v1.json",
  "version": 1,
  "kind": "catalog",
  "id": "regional-series",
  "params": {
    "language": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "label": {
      "type": "string"
    }
  },
  "catalog": {
    "id": "tmdb.discover.${slug}_series",
    "type": "series",
    "name": "${label} Series",
    "displayType": "series",
    "source": "tmdb",
    "metadata": {
      "discover": {
        "version": 1,
        "mediaType": "tv",
        "params": {
          "with_original_language": "${language}",
          "sort_by": "popularity.desc"
        }
      }
    },
    "cacheTTL": 86400
  }
}
