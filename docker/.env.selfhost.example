# ==============================================================================
# Self-Hosted Stack Environment Variables (Copy to docker/.env.selfhost)
# ==============================================================================

# --- Public URLs (set these to your reverse-proxy HTTPS domains in production) ---
AIOSTREAMS_BASE_URL=https://streams.yourdomain.com
AIOMETADATA_BASE_URL=https://metadata.yourdomain.com
AIOMANAGER_CORS_ORIGINS=https://manager.yourdomain.com

# --- Local Host Ports ---
AIOSTREAMS_PORT=3000
AIOMETADATA_PORT=3232
AIOMANAGER_PORT=1610

# --- Encryption & Secret Keys (Generate with: openssl rand -hex 32) ---
# Must be 64-character hex string (32 bytes)
AIOSTREAMS_SECRET_KEY=replace_with_openssl_rand_hex_32
AIOMANAGER_ENCRYPTION_KEY=replace_with_openssl_rand_hex_32

# --- Optional Instance Passwords ---
AIOSTREAMS_ADDON_PASSWORD=
AIOMETADATA_ADDON_PASSWORD=

