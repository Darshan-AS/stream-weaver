#!/usr/bin/env bash
# Auto-regenerates each tenant's LikeC4 model (`tenants/<t>/architecture/`) and
# `tenants/<t>/ARCHITECTURE.md` whenever that tenant's JSON documents change.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if [[ -x ".venv/bin/sw" ]]; then
    SW=".venv/bin/sw"
else
    SW="uv run sw"
fi

staged="$(git diff --cached --name-only)"

# If the architecture compiler itself changed, every tenant's diagram is potentially stale.
if grep -qE '^src/stream_weaver/core/architecture\.py$' <<<"$staged"; then
    tenants="$(find tenants -mindepth 1 -maxdepth 1 -type d -exec test -f '{}/tenant.json' ';' -print | sort)"
else
    tenants="$(grep -oE '^tenants/[^/]+/[^/]+\.json$' <<<"$staged" | cut -d/ -f1-2 | sort -u || true)"
fi

for tenant_dir in $tenants; do
    [[ -f "$tenant_dir/tenant.json" ]] || continue
    echo "🗺️  [pre-commit] Regenerating architecture for $tenant_dir ..."
    $SW diagram --dir "$tenant_dir"
    git add "$tenant_dir/architecture/topology.c4" "$tenant_dir/architecture/likec4.config.json" "$tenant_dir/ARCHITECTURE.md"
done
