# ==============================================================================
# 1. INSTANCE URLS (Hosted defaults shown; swap to self-hosted Docker URLs later)
# ==============================================================================
# No trailing slashes. Examples:
# Public AIOStreams:  https://aiostreams.elfhosted.com (or another public instance)
# Public AIOMetadata: https://aiometadata.elfhosted.com (or another public instance)
# Public AIOManager:  https://aiomanager.elfhosted.com (optional)
AIOSTREAMS_URL=https://aiostreams.elfhosted.com
AIOMETADATA_URL=https://aiometadata.elfhosted.com
AIOMANAGER_URL=https://aiomanager.elfhosted.com

# ==============================================================================
# 2. REQUIRED ESSENTIALS (Minimum needed for a working stack)
# ==============================================================================
# Fill in: (a) at least ONE Debrid / Usenet provider, plus (b) free TMDB & TVDB keys.
# Every `SECRET_*` value stays local in `.env` and is injected into `{{SECRET_*}}`
# in memory on `sw push` / scrubbed back out on `sw pull` or `sw sanitize`.

# (a) Debrid / Usenet Provider (TorBox is enabled in the starter template; switch via `sw packs set --debrid ...`)
SECRET_TORBOX_API_KEY=
SECRET_RD_API_KEY=
SECRET_ALLDEBRID_API_KEY=
SECRET_PREMIUMIZE_API_KEY=
SECRET_EASYNEWS_USERNAME=
SECRET_EASYNEWS_PASSWORD=

# (b) Core Metadata Providers (Free keys)
# TMDB: https://www.themoviedb.org/settings/api
SECRET_TMDB_API_KEY=
SECRET_TMDB_ACCESS_TOKEN=
# TVDB: https://thetvdb.com/api-information
SECRET_TVDB_API_KEY=

# ==============================================================================
# 3. INSTANCE CREDENTIALS (Auto-populated when you run `sw push ... --create` or Studio Wizard)
# ==============================================================================
# Choose strong passwords before running `sw push aiostreams --create` / `sw push aiometadata --create`.
# Leave UUIDs blank on Day 0 — `sw` creates the instances and saves the UUIDs here automatically.

# --- AIOStreams ---
AIOSTREAMS_UUID=
AIOSTREAMS_PASSWORD=
# Auto-harvested after creation/sync:
SECRET_AIOSTREAMS_ENCRYPTED_PASSWORD=
# Optional: only needed if the host instance requires a global addon access password
AIOSTREAMS_ADDON_PASSWORD=

# --- AIOMetadata ---
AIOMETADATA_UUID=
AIOMETADATA_PASSWORD=
# Optional: only needed if the host instance requires a global addon access password
AIOMETADATA_ADDON_PASSWORD=

# --- AIOManager (Cloud Sync — Completely Optional) ---
# Only needed if you enable Cloud Sync in AIOManager (Settings -> Sync)
AIOMANAGER_UUID=
AIOMANAGER_SYNC_PASSWORD=

# ==============================================================================
# 4. OPTIONAL ENHANCEMENTS (Ratings, Discovery, Subtitles, Release Alerts)
# ==============================================================================
# RatingPosterDB (`t0-free-rpdb` works on the free tier)
SECRET_RPDB_API_KEY=
SECRET_TOP_POSTER_API_KEY=
SECRET_FANART_API_KEY=
# Free from https://mdblist.com/preferences (powers 8-source details ratings in Nuvio)
SECRET_MDBLIST_API_KEY=
# Generated by authenticating Trakt in your AIOMetadata Configure page
SECRET_TRAKT_TOKEN_ID=
# BingeCat (https://bingecat.com) — AI recommendations & dynamic micro-genre shelves
SECRET_BINGECAT_TOKEN=
SECRET_WATCHLY_TOKEN=
# ItsOut! (https://itsout.elfhosted.com/configure) — digital release alerts
SECRET_ITSOUT_TOKEN=
# Free from https://subsource.net (SubSource + Strelingo dual-subtitles)
SECRET_SUBSOURCE_API_KEY=
# Optional Nuvio intro/anime skip providers & AI Search LLM keys
SECRET_ANIMESKIP_CLIENT_ID=
SECRET_INTRODB_API_KEY=
SECRET_GEMINI_API_KEY=
SECRET_OPENROUTER_API_KEY=

# Optional one-off backfill script keys (https://developer.trakt.tv/apps & https://simkl.com/settings/developer/)
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
SIMKL_CLIENT_ID=

# ==============================================================================
# 5. CLIENT LOGINS (Populated automatically via `sw login nuvio|stremio`)
# ==============================================================================
SECRET_NUVIO_ACCESS_TOKEN=
SECRET_NUVIO_REFRESH_TOKEN=
SECRET_NUVIO_EMAIL=
SECRET_STREMIO_AUTH_KEY=
SECRET_STREMIO_EMAIL=
# Optional override for Nuvio's public Supabase anon key (built-in default used when blank)
NUVIO_SUPABASE_ANON_KEY=
