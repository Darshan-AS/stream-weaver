  // ==========================================================================
  // 8. Cross-Component Relationships
  // ==========================================================================
  stream_weaver -> aiomanager 'Pushes & pulls encrypted Cloud Sync state' {
    technology 'PBKDF2 + AES-256-GCM'
  }
  stream_weaver -> aiostreams 'Pushes & pulls stream scraper & SEL config' {
    technology 'REST /api/v1/user'
  }
