  aiostreams.subtitle_addons.preset_osv_opensubtitles_v3_fallback -> opensubtitles_srv 'Fetches EN/KN subtitles'
  aiostreams.sel_engine -> aiostreams.group1_primary '1. Queries primary scrapers'
