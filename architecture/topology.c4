// AUTO-GENERATED BY `uv run sw diagram` FROM `configs/*.json` — DO NOT EDIT MANUALLY

specification {
  element client {
    style {
      shape browser
      color indigo
    }
  }
  element controlPlane {
    style {
      shape component
      color amber
    }
  }
  element aggregator {
    style {
      shape component
      color sky
    }
  }
  element addon {
    style {
      shape component
      color green
    }
  }
  element subsystem {
    style {
      shape rectangle
      color slate
    }
  }
  element plugin {
    style {
      shape rectangle
      color blue
    }
  }
  element externalServer {
    style {
      shape storage
      color secondary
    }
  }
  element secretKey {
    style {
      shape cylinder
      color red
    }
  }

  tag enabled
  tag disabled
  tag primary
  tag fallback
  tag debrid
  tag ai
  tag metadata
  tag catalog
  tag secret
}

model {
  // ==========================================================================
  // 1. Streaming Clients & Local GitOps Control Plane
  // ==========================================================================
  controlPlane stream_weaver 'Stream Weaver (sw CLI)' {
    #enabled
    description 'Pure Functional GitOps Control Plane (sw pull / push / sanitize / warm / diagram)'
    technology 'Python 3.14+ / uv / AES-256-GCM'
    link https://github.com/Darshan-AS/stream-weaver 'GitHub Repository'
    metadata {
      architecture 'Functional Core, Imperative Shell'
      commands 'sw pull | sw push | sw sanitize | sw warm | sw diagram'
      crypto 'PBKDF2-HMAC-SHA256 + AES-256-GCM'
    }
  }

  client nuvio 'Nuvio Client' {
    #enabled
    description 'Primary Streaming App with Tabbed Home Collections, AI Picks & Native Sync'
    technology 'Nuvio App (Supabase Sync)'
  }

  client stremio 'Stremio Client' {
    #enabled
    description 'Stremio Media Center Client synced with Addon Manifests'
    technology 'Stremio Desktop / TV / Web'
    link https://web.stremio.com 'Stremio Web'
  }

  // ==========================================================================
  // 2. External Upstream Servers & APIs
  // ==========================================================================
  externalServer torbox_srv 'TorBox Cloud & Debrid API' {
    #debrid
    description 'Cached Debrid Streams, Usenet/Torrent Offloading & Personal Cloud Library'
    technology 'api.torbox.app'
    link https://torbox.app/settings 'TorBox Dashboard'
  }
  externalServer tmdb_srv 'TMDB API (The Movie Database)' {
    #metadata
    description 'Primary Movie/Series Metadata, Regional Discover (HI/KN/JA), People & Search'
    technology 'api.themoviedb.org'
    link https://www.themoviedb.org/settings/api 'TMDB API Settings'
  }
  externalServer tvdb_srv 'TheTVDB API v4' {
    #metadata
    description 'Series & Anime Episode Metadata, Collections & Season Mapping'
    technology 'api4.thetvdb.com'
    link https://thetvdb.com/api-information 'TVDB API Portal'
  }
  externalServer gemini_srv 'Google AI Studio (Gemini)' {
    #ai
    description 'LLM Semantic & Natural-Language Search Provider for AIOMetadata'
    technology 'generativelanguage.googleapis.com'
    link https://aistudio.google.com/ 'Google AI Studio'
  }
  externalServer trakt_srv 'Trakt.tv API' {
    #catalog
    description 'Up Next, Personal Watchlists, Trending/Popular Catalogs & Watch Scrobbling'
    technology 'api.trakt.tv'
    link https://trakt.tv 'Trakt.tv'
  }
  externalServer mal_srv 'MyAnimeList (MAL) / Jikan' {
    #catalog
    description 'Anime Airing, Top Rated, Seasonal Schedule & Genre Catalogs'
    technology 'myanimelist.net'
    link https://myanimelist.net 'MyAnimeList'
  }
  externalServer kitsu_srv 'Kitsu Anime API' {
    #metadata
    description 'Canonical Anime ID Resolution & Anime Movie/Series Search'
    technology 'kitsu.io/api'
  }
  externalServer tvmaze_srv 'TVmaze API' {
    #metadata
    description 'TV Show Search & Broadcast Schedule Lookup'
    technology 'api.tvmaze.com'
  }
  externalServer rpdb_srv 'RatingPosterDB (RPDB)' {
    #metadata
    description 'Rating-Badge Overlay Poster Service for Catalogs & Streams'
    technology 'api.ratingposterdb.com'
    link https://ratingposterdb.com 'RPDB'
  }
  externalServer postersplus_srv 'PostersPlus (Slokker)' {
    #metadata
    description 'Multi-Source Frosted Rating Badges (IMDb, RT, Letterboxd, Trakt, MAL, AniList)'
    technology 'postersplus.slokker.cc'
  }
  externalServer github_srv 'GitHub Raw CDN' {
    #catalog
    description 'Hosts static Contraband Addon manifests & Vidhin05 SEL/Regex release rules'
    technology 'raw.githubusercontent.com'
    link https://github.com/Darshan-AS/aio_contraband 'aio_contraband Repo'
  }
  externalServer tamtaro_srv 'Tamtaro SEL Rule Server' {
    #metadata
    description 'Synced Preferred/Excluded/Included Stream Expressions (PSE/ESE/ISE) & Regex'
    technology 'git.tamtaro.de'
  }
  externalServer opensubtitles_srv 'OpenSubtitles API' {
    #metadata
    description 'Multi-language & AI-Translated Subtitle Provider'
    technology 'opensubtitles.com'
  }

  // ==========================================================================
  // 3. Companion Stremio/Nuvio Addons (including Contraband Internal Pipeline)
  // ==========================================================================
  addon bingecat 'BingeCat AI Assistant' {
    #enabled #ai #catalog
    description 'Personalized AI Movie & Series Recommendations and Micro-Genre Catalogs'
    technology 'bingecat.com'
    link https://bingecat.com 'BingeCat'
  }

  addon contraband 'Contraband (aio_contraband)' {
    #enabled #catalog
    description 'Curated Static Stremio Addon & TorBox Ingestor for Niche Courses & Lectures (Peterson Academy)'
    technology 'dev.darshanas.contraband'
    link https://github.com/Darshan-AS/aio_contraband 'GitHub Repository'
    metadata {
      addon_id 'dev.darshanas.contraband'
      id_prefixes 'sw_, pa_, aiostreams::library.torbox.torrent.'
      resources 'catalog, meta, stream'
    }

    subsystem cb_cli 'Contraband CLI (cb)' {
      #enabled
      description 'Imperative Shell CLI: cb add | cb sync | cb watch | cb list | cb publish'
      technology 'Python 3.14+ / uv'
    }
    subsystem torbox_ingestor 'TorBox Magnet Queue & Slot Promoter' {
      #enabled #debrid
      description 'Queues course magnets, maintains 3 parallel downloads & resolves file IDs'
      technology 'TorBox REST Adapter'
    }
    subsystem static_compiler 'Static Manifest, Catalog & Stream Compiler' {
      #enabled #catalog
      description 'Compiles deterministic Stremio JSON files (manifest.json, catalog/, meta/, stream/)'
      technology 'Pure Functional Core'
    }
    plugin peterson_catalog 'Peterson Academy Catalog' {
      #enabled #catalog
      description 'Curated university-style lectures across 8 humanities & science genres'
      technology 'series / peterson_academy'
    }
  }

  addon cinemeta 'Cinemeta (Official)' {
    #enabled #metadata
    description 'Canonical IMDb (tt) Metadata Fallback (Standard Catalogs & Search Disabled)'
    technology 'v3-cinemeta.strem.io'
  }

  // ==========================================================================
  // 4. AIOManager — Addon Registry, Profiles, Vault & Client Reconciler
  // ==========================================================================
  controlPlane aiomanager 'AIOManager' {
    #enabled
    description 'Central Addon Library, Account Profiles, Key Vault, Autopilot Failover & Client Sync'
    technology 'AIOManager v2.0 (aiomanagerfortheweebs.midnightignite.me)'
    link https://aiomanagerfortheweebs.midnightignite.me 'Live AIOManager Instance'

    subsystem acc_don 'Account Profile: Don' {
      #enabled
      description '4 enabled addons synced across 2 client connections'
      technology 'AIOManager Profile'
      metadata {
        installed_addons 'AIOMetadata, AIOStreams, BingeCat, Cinemeta'
        connections '2'
      }
    }
    plugin conn_don_nuvio 'Nuvio Native Connector' {
      #enabled
      description 'Syncs capabilities: addons, plugins, profiles'
      technology 'native'
    }
    plugin conn_don_stremio 'Stremio Native Connector' {
      #enabled
      description 'Syncs capabilities: addons'
      technology 'native'
    }
    subsystem nuvio_collections 'Nuvio Home Collections Compiler' {
      #enabled #catalog
      description '5 Curated Collections (24 Tabbed Folders) synced to Nuvio'
      technology 'configs/nuvio_collections.json'
      plugin col_for_you_discovery 'For You & Discovery (5 folders)' {
        #enabled #catalog
        description 'Folders: AI Picks For You, Because You Watched, Trending & Popular, Top Rated All-Time, Watchlist & Cloud Library'
        technology 'View: TABBED_GRID'
        metadata {
          collection_id 'col-for-you-discovery'
          folder_count '5'
          folders 'AI Picks For You, Because You Watched, Trending & Popular, Top Rated All-Time, Watchlist & Cloud Library'
          upstream_addons 'aiometadata, aiostreams, bingecat'
        }
      }
      plugin col_streaming_services 'Streaming Services (8 folders)' {
        #enabled #catalog
        description 'Folders: Netflix, Prime Video, Apple TV+, HBO Max, Disney+, Hulu, Paramount+, Peacock'
        technology 'View: TABBED_GRID'
        metadata {
          collection_id 'col-streaming-services'
          folder_count '8'
          folders 'Netflix, Prime Video, Apple TV+, HBO Max, Disney+, Hulu, Paramount+, Peacock'
          upstream_addons 'aiometadata'
        }
      }
      plugin col_indian_cinema 'Indian Cinema & Regional OTT (5 folders)' {
        #enabled #catalog
        description 'Folders: Kannada Cinema, Hindi Cinema & Series, JioHotstar, Sony LIV, ZEE5'
        technology 'View: TABBED_GRID'
        metadata {
          collection_id 'col-indian-cinema'
          folder_count '5'
          folders 'Kannada Cinema, Hindi Cinema & Series, JioHotstar, Sony LIV, ZEE5'
          upstream_addons 'aiometadata'
        }
      }
      plugin col_anime_japanese 'Anime & Japanese (3 folders)' {
        #enabled #catalog
        description 'Folders: Airing & Popular Anime, Top Rated Anime, Japanese Cinema & Drama'
        technology 'View: TABBED_GRID'
        metadata {
          collection_id 'col-anime-japanese'
          folder_count '3'
          folders 'Airing & Popular Anime, Top Rated Anime, Japanese Cinema & Drama'
          upstream_addons 'aiometadata'
        }
      }
      plugin col_courses_docs 'Courses & Documentaries (3 folders)' {
        #enabled #catalog
        description 'Folders: Peterson Academy, Curiosity Stream, Top Documentaries & Docuseries'
        technology 'View: TABBED_GRID'
        metadata {
          collection_id 'col-courses-docs'
          folder_count '3'
          folders 'Peterson Academy, Curiosity Stream, Top Documentaries & Docuseries'
          upstream_addons 'aiometadata, aiostreams'
        }
      }
    }
    subsystem key_vault 'Encrypted API Key Vault' {
      #enabled #secret
      description 'Stores 5 tracked provider keys: AIOStreams · aiostreamsfortheweebsstable.midnightignite.me · 6d639290, TVDB, TMDB, RPDB, Gemini AI'
      technology 'AES-256-GCM Vault'
    }
    subsystem autopilot 'Autopilot Health & Failover Engine' {
      #disabled
      description 'Health checks installed addons (0 failover rules active)'
      technology 'AIOManager Autopilot'
    }
  }

  // ==========================================================================
  // 5. AIOStreams — Stream Aggregator, Debrid Resolver, SEL Filter & Formatter
  // ==========================================================================
  aggregator aiostreams 'AIOStreams' {
    #enabled
    description 'Aggregates scrapers in sequential groups, checks TorBox cache, filters via SEL/Regex & formats streams'
    technology 'AIOStreams v2.36 (aiostreamsfortheweebsstable.midnightignite.me)'
    link https://aiostreamsfortheweebsstable.midnightignite.me 'Live AIOStreams Instance'
    metadata {
      preferred_resolutions '2160p, 1440p, 1080p, 720p, 576p'
      required_languages 'Original, English, Kannada, Hindi, Japanese, Dual Audio, Multi, Dubbed, Unknown'
      preferred_visual_tags 'HDR+DV, HDR10+, HDR10, DV, HDR, 10bit, IMAX'
      deduplicator_keys 'filename, infoHash, smartDetect'
      precache_selector 'count(cached(streams)) == 0 ? uncached(streams) : []'
    }

    subsystem sel_engine 'SEL Filter, Deduplicator & Custom Formatter' {
      #enabled
      description 'Applies synced Tamtaro/Vidhin05 Stream Expressions, Title/Year/Episode matching & custom prism formatting'
      technology 'Stream Expression Language (SEL)'
      metadata {
        title_matching_mode 'exact'
        similarity_threshold '0.85'
        poster_service 'rpdb'
      }
    }
    subsystem svc_torbox 'Debrid Service: Torbox' {
      #enabled #debrid
      description 'Instant cache verification, magnet/usenet resolution & Precache Next Episode'
      technology 'torbox'
    }
    subsystem group1_primary 'Group 1: Primary Sequential Scrapers (Always Run)' {
      #enabled #primary
      description 'Executes 11 primary scrapers in parallel (Contraband, Library, Torrent/Debrid & Anime)'
      technology 'Sequential Group 1 (condition: true)'
      plugin preset_swc_contraband 'Contraband [swc]' {
        #enabled
        description 'Group 1 Primary — Resources: catalog, meta, stream'
        technology 'Preset: custom'
        metadata {
          instance_id 'swc'
          preset_type 'custom'
          resources 'catalog, meta, stream'
          timeout_ms '5000'
          media_types 'all'
        }
      }
      plugin preset_lib_library 'Library [lib]' {
        #enabled
        description 'Group 1 Primary — Resources: stream, catalog, meta'
        technology 'Preset: library'
        metadata {
          instance_id 'lib'
          preset_type 'library'
          resources 'stream, catalog, meta'
          timeout_ms '5000'
          media_types 'all'
        }
      }
      plugin preset_tio_torrentio 'Torrentio [tio]' {
        #enabled
        description 'Group 1 Primary — Resources: stream'
        technology 'Preset: torrentio'
        metadata {
          instance_id 'tio'
          preset_type 'torrentio'
          resources 'stream'
          timeout_ms '7500'
          media_types 'all'
        }
      }
      plugin preset_met_meteor 'Meteor [met]' {
        #enabled
        description 'Group 1 Primary — Resources: stream'
        technology 'Preset: meteor'
        metadata {
          instance_id 'met'
          preset_type 'meteor'
          resources 'stream'
          timeout_ms '7500'
          media_types 'all'
        }
      }
      plugin preset_com_comet 'Comet [com]' {
        #enabled
        description 'Group 1 Primary — Resources: stream'
        technology 'Preset: comet'
        metadata {
          instance_id 'com'
          preset_type 'comet'
          resources 'stream'
          timeout_ms '7500'
          media_types 'all'
        }
      }
      plugin preset_stz_stremthru_torz 'StremThru Torz [stz]' {
        #enabled
        description 'Group 1 Primary — Resources: stream'
        technology 'Preset: stremthruTorz'
        metadata {
          instance_id 'stz'
          preset_type 'stremthruTorz'
          resources 'stream'
          timeout_ms '7500'
          media_types 'all'
        }
      }
      plugin preset_mdf_mediafusion 'MediaFusion [mdf]' {
        #enabled
        description 'Group 1 Primary — Resources: stream'
        technology 'Preset: mediafusion'
        metadata {
          instance_id 'mdf'
          preset_type 'mediafusion'
          resources 'stream'
          timeout_ms '7500'
          media_types 'all'
        }
      }
      plugin preset_tdb_torrentsdb 'TorrentsDB [tdb]' {
        #enabled
        description 'Group 1 Primary — Resources: stream'
        technology 'Preset: torrents-db'
        metadata {
          instance_id 'tdb'
          preset_type 'torrents-db'
          resources 'stream'
          timeout_ms '7500'
          media_types 'all'
        }
      }
      plugin preset_kna_knaben 'Knaben [kna]' {
        #enabled
        description 'Group 1 Primary — Resources: stream'
        technology 'Preset: knaben'
        metadata {
          instance_id 'kna'
          preset_type 'knaben'
          resources 'stream'
          timeout_ms '7500'
          media_types 'all'
        }
      }
      plugin preset_sdx_seadex 'SeaDex [sdx]' {
        #enabled
        description 'Group 1 Primary — Resources: stream'
        technology 'Preset: seadex'
        metadata {
          instance_id 'sdx'
          preset_type 'seadex'
          resources 'stream'
          timeout_ms '7500'
          media_types 'anime'
        }
      }
      plugin preset_atn_animetosho 'AnimeTosho [atn]' {
        #enabled
        description 'Group 1 Primary — Resources: stream'
        technology 'Preset: animetosho'
        metadata {
          instance_id 'atn'
          preset_type 'animetosho'
          resources 'stream'
          timeout_ms '7500'
          media_types 'anime'
        }
      }
    }
    subsystem group2_fallback 'Group 2: Conditional HTTP Fallback Scrapers' {
      #enabled #fallback
      description 'Triggered only when count(cached(totalStreams)) < 3 (3 HTTP scrapers)'
      technology 'Sequential Group 2 (HTTP Streams)'
      plugin preset_soo_sootio 'Sootio [soo]' {
        #enabled
        description 'Group 2 Fallback — Resources: stream'
        technology 'Preset: sootio'
        metadata {
          instance_id 'soo'
          preset_type 'sootio'
          resources 'stream'
          timeout_ms '7500'
          media_types 'all'
          http_providers 'http4khdhub, httpHDHub4u, httpUHDMovies, httpMoviesDrive, httpMKVCinemas, httpMkvDrama, httpMalluMv, httpCineDoze, httpNetflixMirror, httpVixSrc'
        }
      }
      plugin preset_hdh_hd_hub 'HD Hub [hdh]' {
        #enabled
        description 'Group 2 Fallback — Resources: stream'
        technology 'Preset: hdhub'
        metadata {
          instance_id 'hdh'
          preset_type 'hdhub'
          resources 'stream'
          timeout_ms '7500'
          media_types 'all'
        }
      }
      plugin preset_wst_webstreamr 'WebStreamr [wst]' {
        #enabled
        description 'Group 2 Fallback — Resources: stream'
        technology 'Preset: webstreamr'
        metadata {
          instance_id 'wst'
          preset_type 'webstreamr'
          resources 'stream'
          timeout_ms '7500'
          media_types 'all'
        }
      }
    }
    subsystem subtitle_addons 'Subtitle Providers' {
      #enabled
      description '2 multi-language & AI-translated subtitle addons (EN, KN)'
      technology 'OpenSubtitles V3'
      plugin preset_osb_opensubtitles_v3_pro 'OpenSubtitles V3 Pro [osb]' {
        #enabled
        description 'Subtitles — Resources: subtitles'
        technology 'Preset: opensubtitles-v3-plus'
        metadata {
          instance_id 'osb'
          preset_type 'opensubtitles-v3-plus'
          resources 'subtitles'
          timeout_ms '15000'
          media_types 'all'
          languages 'en, kn'
        }
      }
      plugin preset_osv_opensubtitles_v3_fallback 'OpenSubtitles v3 (Fallback) [osv]' {
        #enabled
        description 'Subtitles — Resources: subtitles'
        technology 'Preset: opensubtitles'
        metadata {
          instance_id 'osv'
          preset_type 'opensubtitles'
          resources 'subtitles'
          timeout_ms '10000'
          media_types 'all'
        }
      }
    }
  }

  // ==========================================================================
  // 6. AIOMetadata — Multi-Source Metadata, Catalogs, Search & Rating Posters
  // ==========================================================================
  aggregator aiometadata 'AIOMetadata' {
    #enabled #metadata
    description 'Serves 64 active catalogs (48 on Home), canonical metadata, search & rating posters'
    technology 'AIOMetadata v3.6 (aiometadatafortheweebs.midnightignite.me)'
    link https://aiometadatafortheweebs.midnightignite.me 'Live AIOMetadata Instance'
    metadata {
      active_catalogs '64'
      home_catalogs '48'
      language 'en-US'
      timezone 'Asia/Kolkata'
      trakt_watch_tracking 'True'
    }

    subsystem meta_router 'Core Metadata & ID Router' {
      #enabled #metadata
      description 'Routes Movie (TMDB), Series (TMDB) & Anime (TVDB + KITSU IDs)'
      technology 'Provider Router + Redis Cache'
      metadata {
        movie_provider 'tmdb'
        series_provider 'tmdb'
        anime_provider 'tvdb'
        anime_id_provider 'kitsu'
      }
    }

    subsystem search_router 'Multi-Engine Search Dispatcher' {
      #enabled
      description 'Dispatches queries across 8 enabled search engines'
      technology 'AIOMetadata Search Engine'
      metadata {
        enabled_engines 'tmdb.search, tvdb.search, tvmaze.search, people_search_movie, people_search_series, tvdb.collections.search, kitsu.search.series, kitsu.search.movie'
      }
    }

    plugin gemini_search 'Gemini AI Semantic Search' {
      #disabled #ai
      description 'Natural-language query search via Google AI Studio (Active: False)'
      technology 'gemini.search (SECRET_GEMINI_API_KEY)'
    }

    subsystem poster_engine 'Artwork & Rating Poster Engine' {
      #enabled #metadata
      description 'Generates multi-source rating badge posters (Mode: custom)'
      technology 'postersplus.slokker.cc'
    }
    plugin cat_src_mal 'MyAnimeList (MAL) Anime Catalogs (7)' {
      #enabled #catalog
      description '7 active (3 Home): Airing Now, Popular, Top Rated, Schedule, Genres & Top Movies/Series'
      technology 'Source: mal'
      metadata {
        active_count '7'
        home_count '3'
        sample_catalogs 'Anime Airing Now (anime), Popular Anime (anime), Top Rated Anime (anime), MAL Airing Schedule (anime), MAL Genres (anime), MAL Top Movies (anime), MAL Top Series (anime)'
      }
    }
    plugin cat_src_streaming 'Streaming Platform Catalogs (14 Services) (24)' {
      #enabled #catalog
      description '24 active (24 Home): Netflix, Prime, JioHotstar, HBO Max, Apple TV+, Disney+, Sony LIV, Zee5, Curiosity, Hulu'
      technology 'Source: streaming'
      metadata {
        active_count '24'
        home_count '24'
        sample_catalogs 'Netflix (movie), Netflix (series), Prime Video (movie), Prime Video (series), JioHotstar (movie), JioHotstar (series), HBO Max (movie), HBO Max (series)'
      }
    }
    plugin cat_src_tmdb 'TMDB & Regional Discover Catalogs (22)' {
      #enabled #catalog
      description '22 active (16 Home): Popular, Top Rated, Hindi, Kannada, Japanese & Documentary Discover (SECRET_TMDB_API_KEY)'
      technology 'Source: tmdb'
      metadata {
        active_count '22'
        home_count '16'
        sample_catalogs 'TMDB Popular (movie), TMDB Popular (series), TMDB Top Rated (movie), TMDB Top Rated (series), Hindi Movies (movie), New Hindi Releases (movie), Hindi Series (series), Kannada Movies (movie)'
      }
    }
    plugin cat_src_trakt 'Trakt.tv Catalogs & Watch Tracking (11)' {
      #enabled #catalog
      description '11 active (5 Home): Up Next, Watchlist, Trending, Popular, Calendar & Scrobbling (SECRET_TRAKT_TOKEN_ID)'
      technology 'Source: trakt'
      metadata {
        active_count '11'
        home_count '5'
        sample_catalogs 'Trakt Up Next (series), Trakt Watchlist (movie), Trakt Watchlist (series), Trakt Trending (movie), Trakt Trending (series), Trakt Popular (movie), Trakt Popular (series), Trakt Most Watched (Weekly) (movie)'
      }
    }
  }

  // ==========================================================================
  // 7. Declarative Secrets & API Keys (.env Placeholders)
  // ==========================================================================
  secretKey sec_secret_account_auth_key 'SECRET_ACCOUNT_AUTH_KEY' {
    #secret
    description 'Scrubbed via SecretLens into .env ({{SECRET_*}})'
    technology 'Environment Variable'
  }
  secretKey sec_secret_aiomanager_apikey_7d210008 'SECRET_AIOMANAGER_APIKEY_7D210008' {
    #secret
    description 'Scrubbed via SecretLens into .env ({{SECRET_*}})'
    technology 'Environment Variable'
  }
  secretKey sec_secret_aiometadata_token 'SECRET_AIOMETADATA_TOKEN' {
    #secret
    description 'Scrubbed via SecretLens into .env ({{SECRET_*}})'
    technology 'Environment Variable'
  }
  secretKey sec_secret_aiostreams_encrypted_password 'SECRET_AIOSTREAMS_ENCRYPTED_PASSWORD' {
    #secret
    description 'Scrubbed via SecretLens into .env ({{SECRET_*}})'
    technology 'Environment Variable'
  }
  secretKey sec_secret_bingecat_token 'SECRET_BINGECAT_TOKEN' {
    #secret
    description 'Scrubbed via SecretLens into .env ({{SECRET_*}})'
    technology 'Environment Variable'
  }
  secretKey sec_secret_gemini_api_key 'SECRET_GEMINI_API_KEY' {
    #secret
    description 'Scrubbed via SecretLens into .env ({{SECRET_*}})'
    technology 'Environment Variable'
  }
  secretKey sec_secret_nuvio_access_token 'SECRET_NUVIO_ACCESS_TOKEN' {
    #secret
    description 'Scrubbed via SecretLens into .env ({{SECRET_*}})'
    technology 'Environment Variable'
  }
  secretKey sec_secret_nuvio_email 'SECRET_NUVIO_EMAIL' {
    #secret
    description 'Scrubbed via SecretLens into .env ({{SECRET_*}})'
    technology 'Environment Variable'
  }
